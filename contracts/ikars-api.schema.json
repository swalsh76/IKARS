            {
              "type": "null"
            }
          ]
        },
        "event_ticker": {
          "type": "string"
        },
        "last_price_e6": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "series_ticker": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "volume_24h_e2": {
          "type": "integer"
        },
        "watched": {
          "type": "boolean"
        },
        "yes_ask_e6": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "yes_bid_e6": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ticker",
        "title",
        "event_ticker",
        "series_ticker",
        "category",
        "status",
        "close_time_utc",
        "volume_24h_e2",
        "yes_bid_e6",
        "yes_ask_e6",
        "last_price_e6",
        "watched"
      ],
      "title": "MarketView",
      "type": "object"
    },
    "PortfolioView": {
      "properties": {
        "cash_e6": {
          "type": "integer"
        },
        "cost_e6": {
          "type": "integer"
        },
        "exposure_by_category": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "exposure_by_event": {
          "additionalProperties": {
            "type": "integer"
          },
