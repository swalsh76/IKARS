{
  "$defs": {
    "AlertPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AlertView"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "AlertPage",
      "type": "object"
    },
    "AlertView": {
      "properties": {
        "at": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "outcome": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "line",
        "key",
        "priority",
        "title",
        "text",
        "at",
        "outcome"
      ],
      "title": "AlertView",
      "type": "object"
    },
    "ApiError": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error",
        "detail"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "BookView": {
      "description": "A market's order book: both sides' bids, best first (Kalshi's books are bids only).",
      "properties": {
        "no": {
          "items": {
            "$ref": "#/$defs/Level"
          },
          "type": "array"
        },
        "ready": {
          "type": "boolean"
        },
        "ticker": {
          "type": "string"
        },
        "yes": {
          "items": {
            "$ref": "#/$defs/Level"
          },
          "type": "array"
        }
      },
      "required": [
        "ticker",
        "ready",
        "yes",
        "no"
      ],
      "title": "BookView",
      "type": "object"
    },
    "HealthView": {
      "description": "``GET /v1/health``: the engine's health as it reports it (counts and states only).",
      "properties": {
        "at_utc": {
          "type": "string"
        },
        "parts": {
          "type": "object"
        }
      },
      "required": [
        "at_utc",
        "parts"
      ],
      "title": "HealthView",
      "type": "object"
    },
    "Hello": {
      "description": "``GET /v1/hello``: the version handshake (PLAN D20 G).",
      "properties": {
        "api_version": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "schema_sha256": {
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "engine_version",
        "schema_sha256"
      ],
      "title": "Hello",
      "type": "object"
    },
    "LedgerPage": {
      "properties": {
        "before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "head_seq": {
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LedgerRecordView"
          },
          "type": "array"
        }
      },
      "required": [
        "items",
        "head_seq",
        "before"
      ],
      "title": "LedgerPage",
      "type": "object"
    },
