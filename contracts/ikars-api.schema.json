        "series_ticker": {
          "type": "string"
        },
        "side": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "unrealised_e6": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
