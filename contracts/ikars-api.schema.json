      },
      "required": [
        "ticker",
        "title",
        "side",
        "count_e2",
        "cost_e6",
        "event_ticker",
        "series_ticker",
        "category",
        "exit_price_e6",
        "exit_fee_e6",
        "unrealised_e6"
