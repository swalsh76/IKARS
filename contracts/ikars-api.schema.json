          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "type": "object"
        },
        "fields": {
          "type": "object"
        },
        "kind": {
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "seq": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_local": {
          "type": "string"
        },
        "time_utc": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "kind",
        "time_utc",
        "time_local",
        "source",
        "ticker",
        "cash_e6",
        "fields",
        "context",
        "note"
      ],
      "title": "LedgerRecordView",
      "type": "object"
    },
