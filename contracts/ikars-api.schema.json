      "properties": {
        "last_price_e6": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "ticker": {
          "type": "string"
        },
        "yes_ask_e6": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "yes_bid_e6": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ticker",
        "yes_bid_e6",
        "yes_ask_e6",
        "last_price_e6",
        "received_ns"
