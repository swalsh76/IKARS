    "RecommendationPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/RecommendationView"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "RecommendationPage",
      "type": "object"
    },
    "RecommendationView": {
      "description": "Filled from M1.12; the shape the Overview will show (provenance, PLAN D20 F, comes then).",
      "properties": {
        "at_utc": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "side": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ticker",
        "side",
        "summary",
        "at_utc"
      ],
      "title": "RecommendationView",
      "type": "object"
    },
    "StreamOpened": {
      "description": "The first event of every stream: its id, for ``PUT .../subscriptions``.",
      "properties": {
        "coalesce_ms": {
          "type": "integer"
        },
        "stream_id": {
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "coalesce_ms"
      ],
      "title": "StreamOpened",
      "type": "object"
    },
    "Subscriptions": {
      "additionalProperties": false,
      "description": "``PUT /v1/stream/{id}/subscriptions``: the markets whose quotes and books to stream.",
      "properties": {
        "books": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "quotes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [],
      "title": "Subscriptions",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "stream_events": {
    "alert": "AlertView",
    "book": "BookView",
    "error": "ApiError",
    "health": "HealthView",
    "opened": "StreamOpened",
    "portfolio": "PortfolioView",
    "quote": "QuoteUpdate"
  },
  "title": "IKARS loopback API",
  "version": "1.0"
}
