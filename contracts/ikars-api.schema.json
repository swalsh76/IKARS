        },
        "price_e6": {
          "type": "integer"
        }
      },
      "required": [
        "price_e6",
        "count_e2"
      ],
      "title": "Level",
      "type": "object"
    },
    "MarketPage": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/MarketView"
          },
          "type": "array"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total",
        "offset"
      ],
      "title": "MarketPage",
      "type": "object"
    },
