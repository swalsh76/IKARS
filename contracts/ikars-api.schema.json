        "positions": {
          "items": {
            "$ref": "#/$defs/PositionView"
          },
          "type": "array"
        },
        "unrealised_e6": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
