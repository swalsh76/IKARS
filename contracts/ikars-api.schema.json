      "properties": {
        "head_seq": {
          "type": "integer"
        },
        "reconciled_exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "records": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "tax_zone": {
          "type": "string"
        },
        "verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "records",
        "head_seq",
        "verified",
        "reconciled_exact",
        "tax_zone"
      ],
      "title": "LedgerStatusView",
      "type": "object"
    },
    "Level": {
      "properties": {
        "count_e2": {
