<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:screens="clr-namespace:Ikars.Terminal.Screens"
                    xmlns:views="clr-namespace:Ikars.Terminal.Views">
  <!-- How each screen is drawn (thin: every value and command comes from its view model). Per the approved mock-ups (docs/design/mockups). -->

  <Style x:Key="PanelTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="Panel" TargetType="Border">
    <Setter Property="BorderBrush" Value="#40808080" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,10,10" />
  </Style>

  <!-- a row that is a link -->
  <DataTemplate x:Key="LinkRowTemplate">
    <Button Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Target}"
            HorizontalContentAlignment="Stretch" Padding="6,3" Margin="0,0,0,2" Background="Transparent" BorderThickness="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Margin="8,0,0,0" />
        <StackPanel>
          <TextBlock Text="{Binding Primary}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Secondary}" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Button>
  </DataTemplate>

  <DataTemplate x:Key="FactTemplate">
    <DockPanel Margin="0,1">
      <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" />
      <TextBlock Text="{Binding Label}" Opacity="0.75" Margin="0,0,12,0" />
    </DockPanel>
  </DataTemplate>

  <DataTemplate x:Key="AlertTemplate">
    <StackPanel Margin="0,0,0,6">
      <TextBlock>
        <Run Text="{Binding Priority, Mode=OneWay}" FontWeight="SemiBold" />
        <Run Text=" · " />
        <Run Text="{Binding Title, Mode=OneWay}" />
      </TextBlock>
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Opacity="0.85" />
      <TextBlock Text="{Binding At}" FontSize="11" Opacity="0.6" />
    </StackPanel>
  </DataTemplate>

  <!-- Overview (Main mock-up) -->
  <DataTemplate DataType="{x:Type screens:OverviewScreen}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <UniformGrid Columns="3">
        <Border Style="{StaticResource Panel}">
          <StackPanel>
            <TextBlock Text="Portfolio and exposure" Style="{StaticResource PanelTitle}" />
            <TextBlock><Run Text="Cash " /><Run Text="{Binding Cash, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            <TextBlock><Run Text="Open cost " /><Run Text="{Binding OpenCost, Mode=OneWay}" /></TextBlock>
            <TextBlock><Run Text="Unrealised after exit costs " /><Run Text="{Binding Unrealised, Mode=OneWay}" /></TextBlock>
            <ItemsControl ItemsSource="{Binding Positions}" ItemTemplate="{StaticResource LinkRowTemplate}" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding Exposure}" ItemTemplate="{StaticResource FactTemplate}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}">
          <StackPanel>
            <TextBlock Text="Alerts" Style="{StaticResource PanelTitle}" />
            <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource AlertTemplate}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}">
          <StackPanel>
            <TextBlock Text="Health" Style="{StaticResource PanelTitle}" />
            <ItemsControl ItemsSource="{Binding HealthStrip}" ItemTemplate="{StaticResource FactTemplate}" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{x:Static screens:OverviewScreen.Planned}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel}" Opacity="0.6">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" />
                  <TextBlock><Run Text="arrives in " /><Run Text="{Binding ArrivesIn, Mode=OneWay}" /></TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </UniformGrid>
    </ScrollViewer>
  </DataTemplate>

  <!-- Markets -->
  <DataTemplate DataType="{x:Type screens:MarketsScreen}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="280" ToolTip="Search tickers and titles" />
        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="8,0,0,0" ToolTip="Category (empty: all)" />
        <Button Content="Search" Command="{Binding Search}" Margin="8,0,0,0" IsDefault="True" />
        <Button Content="◀" Command="{Binding Previous}" Margin="16,0,0,0" />
        <Button Content="▶" Command="{Binding Next}" Margin="4,0,0,0" />
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
      </StackPanel>
      <ListView ItemsSource="{Binding Rows}">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Market" Width="520">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{Binding Title}" Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding Target}"
                          Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" FontWeight="{Binding Selected, Converter={x:Static views:Converters.BoldWhen}}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Ticker" DisplayMemberBinding="{Binding Ticker}" Width="220" />
            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="120" />
            <GridViewColumn Header="YES bid" DisplayMemberBinding="{Binding Bid}" Width="80" />
            <GridViewColumn Header="YES ask" DisplayMemberBinding="{Binding Ask}" Width="80" />
            <GridViewColumn Header="Book" Width="60">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Watched, Converter={x:Static views:Converters.WatchedMark}}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </DockPanel>
  </DataTemplate>

  <!-- A market (Market mock-up): quote, chart, book, linked items -->
  <DataTemplate DataType="{x:Type screens:MarketScreen}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Details}" Opacity="0.7" />
        <TextBlock FontSize="16" Margin="0,6,0,0">
          <Run Text="YES bid " /><Run Text="{Binding Bid, Mode=OneWay}" FontWeight="SemiBold" />
          <Run Text="   ask " /><Run Text="{Binding Ask, Mode=OneWay}" FontWeight="SemiBold" />
          <Run Text="   last " /><Run Text="{Binding Last, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <Border DockPanel.Dock="Right" Width="320" Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock Text="Linked to this market" Style="{StaticResource PanelTitle}" />
          <TextBlock Text="Same event" FontWeight="SemiBold" Margin="0,4,0,2" />
          <ItemsControl ItemsSource="{Binding SameEvent}" ItemTemplate="{StaticResource LinkRowTemplate}" />
          <TextBlock Text="Your ledger records" FontWeight="SemiBold" Margin="0,10,0,2" />
          <ItemsControl ItemsSource="{Binding LedgerRecords}" ItemTemplate="{StaticResource LinkRowTemplate}" />
          <TextBlock Text="Source items, recommendations and perps arrive in M2, M1.12 and M3." Opacity="0.6" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" />
          <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="YES price, today" Style="{StaticResource PanelTitle}" />
            <views:MarketChart />
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Panel}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Order book (both sides are bids)" Style="{StaticResource PanelTitle}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding BookNote}" Opacity="0.7" />
            <UniformGrid Columns="2">
              <StackPanel>
                <TextBlock Text="YES bids" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding YesBids}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock><Run Text="{Binding Price, Mode=OneWay}" /><Run Text="  ×  " /><Run Text="{Binding Contracts, Mode=OneWay}" /></TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="NO bids" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding NoBids}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock><Run Text="{Binding Price, Mode=OneWay}" /><Run Text="  ×  " /><Run Text="{Binding Contracts, Mode=OneWay}" /></TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </UniformGrid>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </DataTemplate>

  <!-- Ledger -->
  <DataTemplate DataType="{x:Type screens:LedgerScreen}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
        <Button Content="Newest" Command="{Binding Newest}" Margin="16,0,0,0" />
        <Button Content="Older" Command="{Binding Older}" Margin="4,0,0,0" />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Records}" ItemTemplate="{StaticResource LinkRowTemplate}" />
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <!-- Alerts by priority (Alerts mock-up) -->
  <DataTemplate DataType="{x:Type screens:AlertsScreen}">
    <UniformGrid Columns="3">
      <Border Style="{StaticResource Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Urgent" Style="{StaticResource PanelTitle}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Urgent}" ItemTemplate="{StaticResource AlertTemplate}" /></ScrollViewer>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="High" Style="{StaticResource PanelTitle}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding High}" ItemTemplate="{StaticResource AlertTemplate}" /></ScrollViewer>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Normal and low" Style="{StaticResource PanelTitle}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Other}" ItemTemplate="{StaticResource AlertTemplate}" /></ScrollViewer>
        </DockPanel>
      </Border>
    </UniformGrid>
  </DataTemplate>

  <!-- Health (Health mock-up) -->
  <DataTemplate DataType="{x:Type screens:HealthScreen}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Engine" Style="{StaticResource PanelTitle}" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding FrameTime}" Margin="0,0,0,6" />
          <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FactTemplate}" /></ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Panel}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Gap log (last 7 days)" Style="{StaticResource PanelTitle}" />
          <ListView ItemsSource="{Binding Gaps}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Channel" DisplayMemberBinding="{Binding Channel}" Width="80" />
                <GridViewColumn Header="Reason" DisplayMemberBinding="{Binding Reason}" Width="180" />
                <GridViewColumn Header="End (UTC)" DisplayMemberBinding="{Binding EndUtc}" Width="150" />
                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100" />
                <GridViewColumn Header="Detail" DisplayMemberBinding="{Binding Detail}" Width="180" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
