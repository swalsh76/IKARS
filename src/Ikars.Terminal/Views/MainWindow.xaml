<Window x:Class="Ikars.Terminal.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IKARS" Width="1400" Height="900" MinWidth="900" MinHeight="600">
  <DockPanel>
    <!-- the trail: back, forward, breadcrumbs (PLAN R9) -->
    <DockPanel DockPanel.Dock="Top" Margin="8,6">
      <Button DockPanel.Dock="Left" Content="◀" ToolTip="Back" Width="32" Command="{Binding Navigator.BackCommand}" />
      <Button DockPanel.Dock="Left" Content="▶" ToolTip="Forward" Width="32" Margin="4,0,12,0" Command="{Binding Navigator.ForwardCommand}" />
      <ItemsControl ItemsSource="{Binding Navigator.Breadcrumbs}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Button Content="{Binding Label}" Padding="6,2" Command="{Binding DataContext.Navigator.GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
              <TextBlock Text=" › " VerticalAlignment="Center" Opacity="0.6" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <!-- status: the connection, problems, frame time -->
    <DockPanel DockPanel.Dock="Bottom" Margin="8,4">
      <TextBlock DockPanel.Dock="Right" Text="{Binding FrameTime}" Opacity="0.7" />
      <TextBlock Text="{Binding Connection}" Margin="0,0,16,0" />
      <TextBlock Text="{Binding Problem}" Foreground="IndianRed" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <!-- the menu -->
    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Menu}" Width="140" Margin="8,8,0,8">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding Label}" Margin="0,0,0,6" Padding="8,6" HorizontalContentAlignment="Left"
                  Command="{Binding DataContext.Navigator.GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- the current screen, drawn by its DataTemplate (Views/Screens.xaml) -->
    <ContentControl Content="{Binding Navigator.Current}" Margin="12,8" />
  </DockPanel>
</Window>
