<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Ikars.Terminal</RootNamespace>
    <AssemblyName>Ikars.Terminal</AssemblyName>
    <!-- WPF's built-in Windows 11 theme (ThemeMode) is flagged experimental by the SDK: used deliberately, as in KalTerm3. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ikars.Client\Ikars.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ikars.Terminal.Tests" />
  </ItemGroup>
</Project>
